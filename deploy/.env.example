# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public domain served by Caddy (TLS is automatic). "localhost" uses Caddy's internal CA.
MOWBOT_DOMAIN=localhost
MOWBOT_HTTP_PORT=80
MOWBOT_HTTPS_PORT=443

# openssl rand -base64 24
POSTGRES_PASSWORD=

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts secrets at rest. Back it up: losing it makes stored secrets unreadable.
MOWBOT_MASTER_KEY=

# Optional. Leave empty to get a one-time token printed in the hub logs at first start.
MOWBOT_SETUP_TOKEN=

# Image of the computers (built with --profile build, see README).
MOWBOT_WORKSTATION_IMAGE=mowbot/workstation:local
# Optional OCI runtime for stronger isolation of the computers, e.g. sysbox-runc.
MOWBOT_COMPUTER_RUNTIME=
# Stop computers unused for this many minutes (0 = never).
MOWBOT_COMPUTER_IDLE_MINUTES=30
