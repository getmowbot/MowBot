# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Address(es) Caddy serves, comma-separated. Examples:
#   mowbot.example.com              public domain, Let's Encrypt certificate
#   mowbot.example.com, 192.168.1.20  same, plus the server's LAN IP (Caddy's internal CA)
#   192.168.1.20 or mowbot.lan      LAN only, HTTPS with Caddy's internal CA (trust its root
#                                   certificate once per device, see README)
#   http://192.168.1.20             LAN only, plain HTTP: also set MOWBOT_COOKIE_SECURE=false
#   :80                             plain HTTP on every address of the server (what install.sh
#                                   picks for a LAN), with MOWBOT_COOKIE_SECURE=false too
MOWBOT_DOMAIN=localhost
# true unless MOWBOT_DOMAIN uses http:// (browsers drop Secure cookies over plain HTTP).
MOWBOT_COOKIE_SECURE=true
MOWBOT_HTTP_PORT=80
MOWBOT_HTTPS_PORT=443
# Ports where bots show the web pages they build on their PCs (one per preview, on the same
# address and certificate as the app). Open them in the firewall like 80 and 443 (TCP, and UDP
# for HTTP/3). Always a range here; pick another one if these are taken. A port serves either
# HTTPS or plain HTTP: if MOWBOT_DOMAIN mixes both kinds of addresses, previews are plain HTTP
# and open only through the plain-HTTP ones.
MOWBOT_PREVIEW_PORTS=8800-8819
# Optional: the address the apps reach MowBot at (https://mowbot.example.com), for the links
# bots give. Empty: the address of the apps' latest request.
MOWBOT_PUBLIC_URL=

# openssl rand -base64 24
POSTGRES_PASSWORD=

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts secrets at rest. Back it up: losing it makes stored secrets unreadable.
MOWBOT_MASTER_KEY=

# Optional. Leave empty to get a one-time token printed in the hub logs at first start.
MOWBOT_SETUP_TOKEN=

# Image of the computers (built with --profile build, see README).
MOWBOT_WORKSTATION_IMAGE=mowbot/workstation:local
# Image of the MCP computer, where the MCP servers run (also built with --profile build).
MOWBOT_MCP_IMAGE=mowbot/mcp:local
# Optional OCI runtime for stronger isolation of the computers, e.g. sysbox-runc.
MOWBOT_COMPUTER_RUNTIME=
# Stop computers unused for this many minutes (0 = never).
MOWBOT_COMPUTER_IDLE_MINUTES=30

# Voice messages are transcribed on the hub's CPU with Whisper (downloaded once, ~150 MB).
# onnx-community/whisper-small understands better but is slower (~3x) and heavier (~600 MB).
MOWBOT_WHISPER_MODEL=onnx-community/whisper-base
# Spoken language (fr, en…); empty: the owner's language.
MOWBOT_WHISPER_LANGUAGE=
