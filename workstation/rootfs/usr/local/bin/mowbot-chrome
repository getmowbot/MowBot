#!/usr/bin/env bash
set -euo pipefail
if ! command -v google-chrome >/dev/null; then
  echo "Google Chrome is not installed on this architecture" >&2
  exec sleep infinity
fi
# Without the desktop (MOWBOT_DESKTOP=0) there is no screen: Chrome runs without a window, the
# bots still drive it through its DevTools port.
window=(--start-maximized)
if [ "${MOWBOT_DESKTOP:-1}" = "0" ]; then
  window=(--headless=new --window-size=1280,800)
else
  /usr/local/bin/mowbot-wait-x
  sleep 2 # let the window manager come up so the window opens maximized
fi
# The container is the sandbox, hence --no-sandbox. A non-default profile directory is
# required for the DevTools port the bots use (127.0.0.1 only). Each bot browses in its own
# window: windows behind others must keep rendering, hence the anti-throttling flags.
exec google-chrome \
  --user-data-dir="$HOME/.config/mowbot-chrome" \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=9222 \
  --no-first-run \
  --no-default-browser-check \
  --password-store=basic \
  --no-sandbox \
  --test-type \
  --disable-backgrounding-occluded-windows \
  --disable-renderer-backgrounding \
  --disable-background-timer-throttling \
  "${window[@]}"
