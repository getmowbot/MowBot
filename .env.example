# Local development (read by `pnpm dev`). Copy to .env at the repository root.

# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MOWBOT_MASTER_KEY=

# Embedded Postgres (PGlite) stored under apps/hub/.data — no Docker needed.
# Use postgres://user:pass@localhost:5432/mowbot to target a real Postgres instead.
DATABASE_URL=pglite://.data/pglite

# Optional fixed setup token (otherwise a random one is printed in the hub logs).
MOWBOT_SETUP_TOKEN=

LOG_LEVEL=info

# Computers (P1). The hub talks to Docker (Docker Desktop on Windows/macOS) and publishes each
# computer's agent on 127.0.0.1. Build the image once:
#   docker build -f workstation/Dockerfile -t mowbot/workstation:local .
MOWBOT_WORKSTATION_IMAGE=mowbot/workstation:local
# The MCP computer (where local MCP servers run, no desktop), started like the bots' ones:
#   docker build -f workstation/mcp.Dockerfile -t mowbot/mcp:local .
MOWBOT_MCP_IMAGE=mowbot/mcp:local
# Workspace files, relative to apps/hub (bind-mounted into the computers).
MOWBOT_WORKSPACES_DIR=.data/workspaces
# Stop computers unused for this many minutes (0 = never).
MOWBOT_COMPUTER_IDLE_MINUTES=30

# Web previews: the hub serves the dev servers bots run on their PCs on these ports, next to its
# own address (http://localhost:8800, or the machine's LAN IP from a phone). off: no previews.
MOWBOT_PREVIEW_PORTS=8800-8819
# Optional: where the apps reach the hub, for the links bots give (default: the apps' latest
# request, e.g. http://192.168.1.20 from a phone on the LAN).
MOWBOT_PUBLIC_URL=

# Projects shared from the desktop app are mirrored in the bots' workspaces: the largest one
# mirrored (megabytes of files kept in sync, and files). Bigger: bots work in it directly.
MOWBOT_MIRROR_MAX_MB=500
MOWBOT_MIRROR_MAX_FILES=20000

# Voice messages: transcribed locally with Whisper (downloaded once under MOWBOT_MODELS_DIR),
# decoded with ffmpeg (must be on the PATH, or set MOWBOT_FFMPEG to its path).
MOWBOT_MODELS_DIR=.data/models
MOWBOT_WHISPER_MODEL=onnx-community/whisper-base
# Spoken language (fr, en…); empty: the owner's language.
MOWBOT_WHISPER_LANGUAGE=
MOWBOT_FFMPEG=ffmpeg
