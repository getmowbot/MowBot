# Local development (read by `pnpm dev`). Copy to .env at the repository root.

# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MOWBOT_MASTER_KEY=

# Embedded Postgres (PGlite) stored under apps/hub/.data — no Docker needed.
# Use postgres://user:pass@localhost:5432/mowbot to target a real Postgres instead.
DATABASE_URL=pglite://.data/pglite

# Optional fixed setup token (otherwise a random one is printed in the hub logs).
MOWBOT_SETUP_TOKEN=

LOG_LEVEL=info

# Computers (P1). The hub talks to Docker (Docker Desktop on Windows/macOS) and publishes each
# computer's agent on 127.0.0.1. Build the image once:
#   docker build -f workstation/Dockerfile -t mowbot/workstation:local .
MOWBOT_WORKSTATION_IMAGE=mowbot/workstation:local
# Workspace files, relative to apps/hub (bind-mounted into the computers).
MOWBOT_WORKSPACES_DIR=.data/workspaces
# Stop computers unused for this many minutes (0 = never).
MOWBOT_COMPUTER_IDLE_MINUTES=30
