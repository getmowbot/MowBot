{
  "expo": {
    "name": "MowBot",
    "slug": "mowbot",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mowbot",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#06070a",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.mowbot.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "MowBot connects to your hub on the local network.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.mowbot.app",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06070a"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#06070a"
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "MowBot uses the microphone to record the voice messages you send your bots."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MowBot lets you send photos to your bots.",
          "cameraPermission": "MowBot lets you take a photo to send to your bots.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14e207d9-cafe-466d-a73f-138e4505ce73"
      }
    },
    "owner": "jorislevasseur01"
  }
}
