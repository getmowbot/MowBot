{
  "name": "@mowbot/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
