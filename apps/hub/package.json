    "@electric-sql/pglite": "^0.5.10",
    "@mowbot/agent": "workspace:*",
    "@mowbot/contract": "workspace:*",
    "@mowbot/design": "workspace:*",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
